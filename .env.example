# --- CONFIGURAÇÕES DO INVITE-APP (SaaS) ---

# App Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SUPABASE (Banco, Auth e Operações Privilegiadas) ---
# Encontre em: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://sua-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-jwt
# Chave Service Role é usada no Webhook da Stripe para bypass no RLS. Mantenha em segredo absoluto.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Database (Obrigatório apenas para rodar scripts de migração/TDD no CLI)
# Formato: postgresql://postgres:[SENHA]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:sua-senha@db.sua-url.supabase.co:5432/postgres

# hCaptcha (site key, público) — obrigatório se "Enable Captcha protection"
# estiver ligado no Supabase Auth (Authentication -> Settings -> Bot and
# Abuse Protection), senão login/cadastro/recuperar-senha são rejeitados
# com "captcha protection: request disallowed". A secret key fica só no
# Supabase Dashboard, nunca aqui. Sem essa variável, o site funciona sem
# captcha (ok só se o Supabase também estiver sem captcha configurado).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=sua-site-key-do-hcaptcha
# Usada pelos scripts em scripts/*.js (list-tables, check-grants etc.).
# NUNCA coloque a senha real aqui nem em nenhum arquivo versionado.
SUPABASE_DB_PASSWORD=sua-senha-do-postgres

# --- MONETIZAÇÃO (Stripe) ---
# Encontre em: Dashboard do Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Encontre webhook secret em: Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Só em desenvolvimento local (NODE_ENV != production): ative para pular o
# Stripe de verdade e ativar o evento direto. NUNCA defina em produção.
ALLOW_MOCK_CHECKOUT=false

# --- MÍDIA (Cloudinary) ---
# Obrigatório para fotos dos presentes e Galeria do Evento
# Encontre em: Dashboard do Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret

# --- SEGURANÇA E AUTH ---
# ADMIN_PASSWORD= (Removido na STORY-039. Faça login via Supabase Magic Link ou Email/Senha)

# --- CURA AUTÔNOMA DE LINKS & IA ---
OPENAI_API_KEY=sk-proj-seu-token-da-openai

# AFILIAÇÃO DIRETA (MONETIZAÇÃO ALTERNATIVA)
AMAZON_AFFILIATE_TAG=sua-tag-amazon-20
AMAZON_PA_API_ACCESS_KEY=sua-access-key-da-paapi
AMAZON_PA_API_SECRET_KEY=sua-secret-key-da-paapi
AMAZON_CREATORS_API_CLIENT_ID=seu-client-id-creators
AMAZON_CREATORS_API_CLIENT_SECRET=seu-client-secret-creators
SERP_API_KEY=sua-chave-serp-api-para-bypass-amazon
SERP_WOW_API_KEY=sua-chave-serpwow-para-bypass-amazon
MAGALU_STORE_NAME=sua-loja-parceiro-magalu

# MAGALU API CREDENTIALS
MAGALU_API_ID=seu-api-id-uuid
MAGALU_API_KEY=sua-api-key-uuid
MAGALU_API_SECRET=sua-api-secret-uuid
